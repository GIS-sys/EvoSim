# Files the viewer writes into the working directory by default
/genome_export.asm
/snapshot.evck
/policies.json
/schedule.json

# Stats written outside run directories
stats_*.parquet
stats_*.csv

# ---------- Warp / GPU caches (normally live in your user profile, listed in case they appear here) ----------
.warp/
warp_cache/
*.cubin
*.ptx
*.pdb
*.obj

